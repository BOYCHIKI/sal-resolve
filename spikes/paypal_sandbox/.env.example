# Sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox). Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox PERSONAL (buyer) account email, used only in the PayPal-Auth-Assertion for S3.
PAYPAL_SANDBOX_BUYER_EMAIL=
# Filled after registering the webhook in S7.
PAYPAL_WEBHOOK_ID=
# Optional; defaults to data/golden/v1.0.0 in this repo.
GOLDEN_DATASET_DIR=
