# Local dev (docker compose). Each runtime role gets its own connection; none can bypass RLS.
SAL_APP_DATABASE_URL=postgresql+psycopg://sal_app:app_dev_only@127.0.0.1:54329/sal
SAL_WORKER_DATABASE_URL=postgresql+psycopg://sal_worker:worker_dev_only@127.0.0.1:54329/sal
SAL_MIGRATOR_DATABASE_URL=postgresql+psycopg://sal_migrator:migrator_dev_only@127.0.0.1:54329/sal
# Server-side demo identity until real auth exists. Create it with: python -m app.seed
SAL_DEMO_MERCHANT_ID=
# PayPal Sandbox (same values as spikes/paypal_sandbox/.env)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# LLM (OpenAI-compatible). Gemini free tier by default; leave the key empty to use the baseline roles.
SAL_LLM_API_KEY=
SAL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SAL_LLM_MODEL=gemini-3.8-flash
# Private evidence storage (default: apps/api/storage)
SAL_STORAGE_DIR=
