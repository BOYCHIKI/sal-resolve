# Local dev (docker compose). Each runtime role gets its own connection; none can bypass RLS.
SAL_APP_DATABASE_URL=postgresql+psycopg://sal_app:app_dev_only@127.0.0.1:15432/sal
SAL_WORKER_DATABASE_URL=postgresql+psycopg://sal_worker:worker_dev_only@127.0.0.1:15432/sal
SAL_MIGRATOR_DATABASE_URL=postgresql+psycopg://sal_migrator:migrator_dev_only@127.0.0.1:15432/sal
# Server-side demo identity until real auth exists. Create it with: python -m app.seed
SAL_DEMO_MERCHANT_ID=
# PayPal Sandbox (same values as spikes/paypal_sandbox/.env)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# LLM: OpenAI (ADR-004). Off unless SAL_AGENT_ROLES=llm; the deterministic baseline runs otherwise.
# Use a project-scoped key with a monthly spending limit. If the model fails, analysis falls back to baseline.
SAL_AGENT_ROLES=baseline
SAL_LLM_API_KEY=
SAL_LLM_MODEL=gpt-5-nano
# Reasoning models (gpt-5*): keep effort low. Non-reasoning models (gpt-4.1*): set SAL_LLM_TEMPERATURE=0 instead.
SAL_LLM_REASONING_EFFORT=low
SAL_LLM_TEMPERATURE=
# Empty = https://api.openai.com/v1 (any OpenAI-compatible endpoint works)
SAL_LLM_BASE_URL=
# Private evidence storage (default: apps/api/storage)
SAL_STORAGE_DIR=

# Environment: dev (default) or prod. prod refuses to start without SAL_INTERNAL_TOKEN and with dev passwords.
SAL_ENV=dev
# Shared secret between the web server and the API (32+ characters, same value in apps/web). When set, the API
# answers only callers that send it; /api/health and the PayPal webhook stay open. Required in prod.
SAL_INTERNAL_TOKEN=
