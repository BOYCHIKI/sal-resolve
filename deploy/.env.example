# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Make each password and the token long and random, e.g.:  openssl rand -hex 24

# The site's address. With no domain of your own, use the server's public IP through sslip.io,
# e.g. 129-150-10-20.sslip.io for 129.150.10.20; Caddy then gets an HTTPS certificate for it.
SAL_DOMAIN=

POSTGRES_PASSWORD=
SAL_MIGRATOR_PASSWORD=
SAL_APP_PASSWORD=
SAL_WORKER_PASSWORD=
SAL_INTERNAL_TOKEN=

# Reading documents and the AI agents (set a spending limit on this key in the OpenAI dashboard).
SAL_AGENT_ROLES=llm
SAL_LLM_API_KEY=
SAL_LLM_MODEL=gpt-5-nano
SAL_LLM_REASONING_EFFORT=low

# PayPal Sandbox (optional): the demo business syncs Sandbox disputes with these.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SAL_DEMO_MERCHANT_ID=
SAL_WATCH_MINUTES=10
